# Copy this file to .env.local and fill in your real key.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL="Portfolio Contact Form <onboarding@resend.dev>"
CONTACT_TO_EMAIL=hello@quadriismail.com

# Public Cloudflare Turnstile site key (safe to expose in browser code).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Private Cloudflare Turnstile secret key. Keep this server-side only.
TURNSTILE_SECRET_KEY=
